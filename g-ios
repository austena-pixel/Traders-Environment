<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>G·IOS — Goals Intelligence Operating System</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --bg:#07090d; --panel:#10131a; --panel2:#151922; --soft:#0c0f15;
  --text:#f5f7fb; --muted:#8f98aa; --line:#232936;
  --accent:#6ea8ff; --accent2:#8b5cf6; --good:#36d399;
  --warn:#fbbf24; --danger:#fb7185;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
body{
  min-height:100vh;color:var(--text);
  background:
    radial-gradient(circle at 14% 8%,rgba(110,168,255,.12),transparent 28%),
    radial-gradient(circle at 86% 4%,rgba(139,92,246,.11),transparent 26%),
    var(--bg);
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}
.app{min-height:100vh;display:grid;grid-template-columns:245px 1fr}

/* Sidebar */
.sidebar{
  position:sticky;top:0;height:100vh;padding:22px 18px;
  border-right:1px solid var(--line);
  background:rgba(7,9,13,.9);backdrop-filter:blur(18px)
}
.brand{display:flex;align-items:center;gap:12px;margin:2px 6px 28px}
.logo{
  width:40px;height:40px;border-radius:13px;display:grid;place-items:center;
  font-weight:900;background:linear-gradient(135deg,var(--accent),var(--accent2))
}
.brand h1{margin:0;font-size:18px;letter-spacing:.04em}
.brand small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.nav{display:grid;gap:6px}
.nav button{
  border:0;background:transparent;color:var(--muted);text-align:left;
  padding:11px 12px;border-radius:10px
}
.nav button:hover,.nav button.active{background:var(--panel2);color:var(--text)}
.side-bottom{position:absolute;left:18px;right:18px;bottom:18px;display:grid;gap:8px}
.side-btn{
  border:1px solid var(--line);background:#0d1118;color:#cbd4e1;
  border-radius:11px;padding:10px 12px
}
.side-btn.signout{color:#ff9cab;border-color:rgba(251,113,133,.22)}

/* Main */
.main{width:100%;max-width:1500px;margin:0 auto;padding:26px 30px 44px}
.topbar{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:16px}
.topbar h2{margin:0;font-size:28px;letter-spacing:-.02em}
.topbar p{margin:6px 0 0;color:var(--muted);font-size:13px}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{
  border:1px solid var(--line);background:var(--panel);color:var(--text);
  border-radius:11px;padding:10px 14px
}
.btn.primary{border:0;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--accent2))}
.btn.small{padding:7px 10px;font-size:11px}
.btn:hover{filter:brightness(1.06)}

.section-head{display:flex;justify-content:space-between;align-items:end;gap:14px;margin:8px 0 10px}
.section-head h3{margin:0;font-size:15px}
.section-head span{color:var(--muted);font-size:11px}

/* Compact overview */
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
.metric{padding:10px 13px;min-height:66px;border-radius:12px;background:var(--soft);border:1px solid #1c2230}
.metric small{display:block;color:var(--muted);font-size:11px}
.metric b{display:block;font-size:18px;margin-top:4px}
.metric em{display:block;font-size:10px;color:#6f7a8c;font-style:normal}

/* Current focus */
.grid{display:grid;grid-template-columns:1.18fr .82fr;gap:18px}
.card{
  border:1px solid var(--line);
  background:linear-gradient(180deg,rgba(21,25,34,.97),rgba(16,19,26,.97));
  border-radius:18px;padding:19px
}
.card h3{margin:0;font-size:15px}
.sub{margin-top:5px;color:var(--muted);font-size:12px}
.focus-list{display:grid;gap:10px;margin-top:16px}
.focus{
  display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;
  padding:13px;border-radius:13px;background:var(--soft);border:1px solid #1c2230
}
.rank{
  width:30px;height:30px;border-radius:9px;display:grid;place-items:center;
  color:var(--accent);font-weight:800;background:#161c28
}
.focus b{display:block;font-size:13px}
.focus small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.chip{
  display:inline-block;font-size:10px;padding:6px 8px;border-radius:999px;
  border:1px solid #283247;background:#151c29;color:#b8c8e8
}
.chip.high{color:#ffe0a3;border-color:rgba(251,191,36,.25);background:rgba(251,191,36,.07)}
.chip.risk{color:#ffb0bd;border-color:rgba(251,113,133,.25);background:rgba(251,113,133,.07)}
.intel{
  margin-top:14px;padding:14px;border-radius:13px;
  border:1px solid rgba(110,168,255,.18);background:rgba(110,168,255,.055)
}
.intel strong{display:block;font-size:12px}
.intel p{margin:6px 0 0;color:#aeb8c8;font-size:12px;line-height:1.55}

/* Goal ladder */
.ladder{display:grid;gap:8px;margin-top:16px}
.level{
  position:relative;padding:11px 12px 11px 36px;border:1px solid #1d2430;
  background:#0d1118;border-radius:12px
}
.level::before{
  content:"";position:absolute;left:15px;top:17px;width:8px;height:8px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2))
}
.level:not(:last-child)::after{
  content:"";position:absolute;left:18px;top:27px;width:2px;height:26px;background:#273244
}
.level span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em}
.level b{display:block;font-size:12px;margin-top:3px}

/* Planning system */
.plan-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.plan-card{
  border:1px solid var(--line);background:var(--panel);border-radius:16px;padding:15px;min-height:150px
}
.plan-card .kicker{font-size:10px;color:#9cbdf0;text-transform:uppercase;letter-spacing:.08em}
.plan-card h4{font-size:14px;margin:7px 0 6px}
.plan-card p{font-size:11px;color:var(--muted);line-height:1.45;margin:0}
.plan-card .count{margin-top:12px;font-size:11px;color:#cdd6e4}

/* Goals */
.goal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.goal-card{
  border:1px solid var(--line);background:var(--panel);border-radius:16px;padding:16px;
  min-height:195px;cursor:pointer
}
.goal-card:hover{border-color:#33405a}
.goal-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.domain{font-size:10px;color:#9cbdf0;letter-spacing:.08em;text-transform:uppercase}
.goal-card h4{margin:7px 0 6px;font-size:14px;line-height:1.35}
.goal-card p{margin:0;color:var(--muted);font-size:11px;line-height:1.5}
.progress-head{display:flex;justify-content:space-between;margin:14px 0 6px;font-size:11px}
.progress{height:8px;background:#0a0d12;border-radius:999px;overflow:hidden}
.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2))}
.goal-foot{display:flex;justify-content:space-between;gap:8px;margin-top:12px;color:var(--muted);font-size:10px}
.goal-actions{display:flex;gap:7px;margin-top:12px}
.goal-actions button{
  border:1px solid var(--line);background:#0d1118;color:#cbd4e1;border-radius:8px;padding:6px 8px;font-size:10px
}

/* Bottom */
.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}
.list{display:grid;gap:9px;margin-top:14px}
.list-item{
  display:flex;justify-content:space-between;gap:12px;padding:11px 12px;
  border:1px solid #1d2430;background:#0d1118;border-radius:11px
}
.list-item strong{display:block;font-size:12px}
.list-item span{display:block;color:var(--muted);font-size:10px;margin-top:3px}
.list-item b{font-size:11px;white-space:nowrap}
.empty{color:var(--muted);font-size:12px;padding:16px 2px}

/* Modal */
.modal{
  position:fixed;inset:0;z-index:30;display:none;place-items:center;padding:18px;
  background:rgba(0,0,0,.65)
}
.modal.show{display:grid}
.modal-box{width:min(560px,100%);border:1px solid var(--line);background:#12161e;border-radius:18px;padding:21px}
.modal-box h3{margin:0 0 5px;font-size:19px}
.modal-box p{margin:0 0 18px;color:var(--muted);font-size:12px;line-height:1.5}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field{display:grid;gap:6px}
.field.full{grid-column:1/-1}
label{font-size:11px;color:#c7cfdb}
input,select,textarea{
  width:100%;border:1px solid var(--line);background:#0a0d12;color:var(--text);
  border-radius:10px;padding:11px 12px;outline:none
}
textarea{min-height:80px;resize:vertical}
.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:14px}
.toast{
  position:fixed;right:18px;bottom:18px;z-index:50;opacity:0;transform:translateY(8px);
  pointer-events:none;transition:.2s ease;border:1px solid #263145;background:#111721;
  color:#dce6f5;border-radius:11px;padding:11px 13px;font-size:12px
}
.toast.show{opacity:1;transform:translateY(0)}

@media(max-width:1100px){
  .plan-grid{grid-template-columns:1fr 1fr}
  .goal-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:900px){
  .app{grid-template-columns:1fr}
  .sidebar{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line)}
  .nav{grid-template-columns:repeat(3,1fr)}
  .side-bottom{position:static;grid-template-columns:1fr 1fr;margin-top:16px}
  .main{padding:20px}
  .grid,.bottom-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  .topbar{flex-direction:column}
  .metrics,.plan-grid{grid-template-columns:1fr 1fr}
  .goal-grid{grid-template-columns:1fr}
  .nav{grid-template-columns:1fr 1fr}
  .focus{grid-template-columns:32px 1fr}
  .focus .chip{grid-column:2;justify-self:start}
  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:1}
  .main{padding:16px}
}
</style>
</head>
<body>

<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="logo">G</div>
      <div>
        <h1>G·IOS</h1>
        <small>Goals Intelligence Operating System</small>
      </div>
    </div>

    <nav class="nav">
      <button class="active">Overview</button>
      <button onclick="goTo('planningSection')">Goal System</button>
      <button onclick="goTo('goalsSection')">Goals</button>
      <button onclick="goTo('focusSection')">Priorities</button>
      <button onclick="goTo('milestonesSection')">Milestones</button>
      <button onclick="showToast('Reviews will be added in the next build.')">Reviews</button>
    </nav>

    <div class="side-bottom">
      <button class="side-btn" onclick="returnToHIOS()">← H·IOS Family</button>
      <button class="side-btn signout" onclick="signOut()">Sign Out</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div>
        <h2>Goal Intelligence Dashboard</h2>
        <p>Yearly → Monthly → Weekly → Daily goals, dynamically prioritized by G·IOS.</p>
      </div>
      <div class="actions">
        <button class="btn" onclick="showToast('G·IOS currently ranks by priority, progress and deadline. Cross-intelligence comes next.')">Why this order?</button>
        <button class="btn primary" onclick="openGoalModal()">+ Add Goal</button>
      </div>
    </header>

    <div class="section-head">
      <h3>Intelligence Overview</h3>
      <span>Your current goal state</span>
    </div>

    <section class="metrics">
      <div class="metric"><small>Active goals</small><b id="mActive">0</b><em>All time horizons</em></div>
      <div class="metric"><small>High priority</small><b id="mHigh">0</b><em>Need attention</em></div>
      <div class="metric"><small>On track</small><b id="mTrack">0</b><em>Progress ≥ 50%</em></div>
      <div class="metric"><small>At risk</small><b id="mRisk">0</b><em>High priority + low progress</em></div>
    </section>

    <section class="grid">
      <div class="card" id="focusSection">
        <h3>Today's Dynamic Priorities</h3>
        <div class="sub">G·IOS highlights what deserves attention now.</div>
        <div class="focus-list" id="focusList"></div>
        <div class="intel">
          <strong>Priority Intelligence</strong>
          <p id="priorityInsight">G·IOS will increasingly combine goal data with live signals from T·IOS, S·IOS and future H·IOS products.</p>
        </div>
      </div>

      <div class="card">
        <h3>Selected Goal Ladder</h3>
        <div class="sub">The systematic goal structure we established earlier.</div>
        <div class="ladder">
          <div class="level"><span>Yearly goal</span><b id="ladderYear">Choose a goal below</b></div>
          <div class="level"><span>Monthly milestone</span><b id="ladderMonth">—</b></div>
          <div class="level"><span>Weekly target</span><b id="ladderWeek">—</b></div>
          <div class="level"><span>Daily action</span><b id="ladderDay">—</b></div>
        </div>
      </div>
    </section>

    <div class="section-head" id="planningSection" style="margin-top:25px">
      <h3>Systematic Goal Planning</h3>
      <span>Build down from long-term direction to today's action</span>
    </div>

    <section class="plan-grid">
      <div class="plan-card">
        <div class="kicker">Yearly</div>
        <h4>Direction</h4>
        <p>Defines the major outcome you want to achieve this year.</p>
        <div class="count" id="yearCount">0 yearly goals</div>
      </div>
      <div class="plan-card">
        <div class="kicker">Monthly</div>
        <h4>Milestones</h4>
        <p>Breaks yearly goals into measurable monthly progress.</p>
        <div class="count" id="monthCount">0 monthly goals</div>
      </div>
      <div class="plan-card">
        <div class="kicker">Weekly</div>
        <h4>Execution Targets</h4>
        <p>Defines what must be completed this week to stay on track.</p>
        <div class="count" id="weekCount">0 weekly goals</div>
      </div>
      <div class="plan-card">
        <div class="kicker">Daily</div>
        <h4>Immediate Action</h4>
        <p>Converts goals into concrete actions that can be executed today.</p>
        <div class="count" id="dayCount">0 daily goals</div>
      </div>
    </section>

    <div class="section-head" id="goalsSection" style="margin-top:25px">
      <h3>Goals</h3>
      <span>Click a goal to view its Yearly → Monthly → Weekly → Daily ladder</span>
    </div>

    <section class="goal-grid" id="goalGrid"></section>

    <section class="bottom-grid" id="milestonesSection">
      <div class="card">
        <h3>Upcoming Milestones</h3>
        <div class="sub">What is approaching next.</div>
        <div class="list" id="milestoneList"></div>
      </div>

      <div class="card">
        <h3>Cross-Intelligence Inputs</h3>
        <div class="sub">How other H·IOS products will influence priorities.</div>
        <div class="list">
          <div class="list-item">
            <div><strong>T·IOS</strong><span>Trading phase, sample progress, execution quality and rule adherence</span></div>
            <b>Connected</b>
          </div>
          <div class="list-item">
            <div><strong>S·IOS</strong><span>Assessment dates, study progress, workload and academic milestones</span></div>
            <b>Future</b>
          </div>
          <div class="list-item">
            <div><strong>Future ·IOS</strong><span>Relevant domain evidence can adjust G·IOS priorities</span></div>
            <b>Expandable</b>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="modal" id="goalModal">
  <div class="modal-box">
    <h3>Add Goal</h3>
    <p>Create a goal using the H·IOS goal hierarchy.</p>
    <form id="goalForm">
      <div class="form-grid">
        <div class="field full">
          <label>Goal title</label>
          <input id="goalTitle" required placeholder="e.g. Complete Phase 1 trading sample">
        </div>

        <div class="field">
          <label>Time horizon</label>
          <select id="goalHorizon">
            <option value="yearly">Yearly</option>
            <option value="monthly">Monthly</option>
            <option value="weekly">Weekly</option>
            <option value="daily">Daily</option>
          </select>
        </div>

        <div class="field">
          <label>Domain</label>
          <select id="goalDomain">
            <option>Trading</option>
            <option>Education</option>
            <option>Career</option>
            <option>Fitness</option>
            <option>Business</option>
            <option>Personal</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field">
          <label>Priority</label>
          <select id="goalPriority">
            <option value="high">High</option>
            <option value="medium" selected>Medium</option>
            <option value="low">Low</option>
          </select>
        </div>

        <div class="field">
          <label>Progress %</label>
          <input id="goalProgress" type="number" min="0" max="100" value="0">
        </div>

        <div class="field">
          <label>Target date</label>
          <input id="goalDate" type="date">
        </div>

        <div class="field full">
          <label>Why this goal matters</label>
          <textarea id="goalWhy" placeholder="Reason or intended outcome"></textarea>
        </div>

        <div class="field full">
          <label>Parent goal (optional)</label>
          <select id="goalParent">
            <option value="">None</option>
          </select>
        </div>
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" onclick="closeGoalModal()">Cancel</button>
        <button class="btn primary" type="submit">Create Goal</button>
      </div>
    </form>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* Same H·IOS / T·IOS Supabase authentication */
const SUPABASE_URL = "https://tmxosoyqflmwqzjgnkez.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_meHq49fLyw8PVNPZxWacnw_SQMj5B-h";
const db = window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);

let currentUser = null;
let goals = [];
let storageKey = "gios_goals_guest";

const starterGoals = [
  {
    id:"year_trading",
    title:"Become consistently disciplined in trading execution",
    horizon:"yearly",
    domain:"Trading",
    priority:"high",
    progress:35,
    targetDate:"",
    why:"Build professional trading behavior before focusing on wealth accumulation.",
    parentId:""
  },
  {
    id:"month_trading",
    title:"Complete current Phase 1 execution sample",
    horizon:"monthly",
    domain:"Trading",
    priority:"high",
    progress:61,
    targetDate:"",
    why:"Prove execution quality across a full sample.",
    parentId:"year_trading"
  },
  {
    id:"week_trading",
    title:"Complete remaining clean trades this week",
    horizon:"weekly",
    domain:"Trading",
    priority:"high",
    progress:55,
    targetDate:"",
    why:"Advance the current sample without breaking rules.",
    parentId:"month_trading"
  },
  {
    id:"day_trading",
    title:"Execute only predefined setups and complete reflection",
    horizon:"daily",
    domain:"Trading",
    priority:"high",
    progress:20,
    targetDate:"",
    why:"Protect execution quality today.",
    parentId:"week_trading"
  },
  {
    id:"year_study",
    title:"Progress successfully through mechanical engineering studies",
    horizon:"yearly",
    domain:"Education",
    priority:"high",
    progress:58,
    targetDate:"",
    why:"Build professional engineering competence.",
    parentId:""
  }
];

async function init(){
  try{
    const {data,error} = await db.auth.getSession();
    if(error || !data?.session?.user){
      window.location.replace("/src/app/index.html");
      return;
    }
    currentUser = data.session.user;
    storageKey = "gios_goals_" + currentUser.id;
    loadGoals();
    renderAll();
  }catch(err){
    console.error(err);
    window.location.replace("/src/app/index.html");
  }
}

function loadGoals(){
  try{
    const saved = localStorage.getItem(storageKey);
    if(saved){
      const parsed = JSON.parse(saved);
      if(Array.isArray(parsed)) goals = parsed;
    }
  }catch(e){}

  if(!Array.isArray(goals) || goals.length === 0){
    goals = starterGoals.map(g => ({...g}));
    saveGoals();
  }
}

function saveGoals(){
  localStorage.setItem(storageKey,JSON.stringify(goals));
}

function renderAll(){
  renderMetrics();
  renderCounts();
  renderPriorities();
  renderGoals();
  renderMilestones();
  renderParentOptions();
}

function renderMetrics(){
  const active = goals.filter(g => Number(g.progress) < 100);
  const high = active.filter(g => g.priority === "high");
  const track = active.filter(g => Number(g.progress) >= 50);
  const risk = active.filter(g => g.priority === "high" && Number(g.progress) < 35);

  mActive.textContent = active.length;
  mHigh.textContent = high.length;
  mTrack.textContent = track.length;
  mRisk.textContent = risk.length;
}

function renderCounts(){
  yearCount.textContent = countHorizon("yearly") + " yearly goals";
  monthCount.textContent = countHorizon("monthly") + " monthly goals";
  weekCount.textContent = countHorizon("weekly") + " weekly goals";
  dayCount.textContent = countHorizon("daily") + " daily goals";
}

function countHorizon(h){ return goals.filter(g => g.horizon === h).length; }

function goalScore(goal){
  let score = goal.priority === "high" ? 60 : goal.priority === "medium" ? 35 : 15;
  const p = Number(goal.progress||0);
  if(p < 25) score += 20; else if(p < 60) score += 10;

  if(goal.horizon === "daily") score += 20;
  else if(goal.horizon === "weekly") score += 12;
  else if(goal.horizon === "monthly") score += 6;

  if(goal.targetDate){
    const today = new Date(); today.setHours(0,0,0,0);
    const due = new Date(goal.targetDate+"T00:00:00");
    const days = Math.ceil((due-today)/86400000);
    if(days <= 0) score += 45;
    else if(days <= 2) score += 35;
    else if(days <= 7) score += 22;
    else if(days <= 30) score += 8;
  }
  return score;
}

function urgency(goal){
  const s = goalScore(goal);
  if(s >= 90) return "Very high";
  if(s >= 65) return "High";
  if(s >= 40) return "Moderate";
  return "Maintain";
}

function rankedGoals(){
  return [...goals].filter(g=>Number(g.progress)<100).sort((a,b)=>goalScore(b)-goalScore(a));
}

function renderPriorities(){
  const ranked = rankedGoals().slice(0,4);
  if(!ranked.length){
    focusList.innerHTML = '<div class="empty">No active priorities.</div>';
    return;
  }

  focusList.innerHTML = ranked.map((g,i)=>{
    const u = urgency(g);
    const cls = u==="Very high" ? "risk" : u==="High" ? "high" : "";
    return `
      <div class="focus">
        <div class="rank">${i+1}</div>
        <div>
          <b>${esc(g.title)}</b>
          <small>${cap(g.horizon)} · ${esc(g.domain)} · ${formatDue(g.targetDate)} · ${Number(g.progress||0)}%</small>
        </div>
        <span class="chip ${cls}">${u}</span>
      </div>`;
  }).join("");

  priorityInsight.textContent =
    ranked[0].title + " currently has the strongest attention signal based on priority, time horizon, progress and deadline.";
}

function renderGoals(){
  if(!goals.length){
    goalGrid.innerHTML = '<div class="empty">No goals yet.</div>';
    return;
  }

  const order = {yearly:1,monthly:2,weekly:3,daily:4};

  goalGrid.innerHTML = [...goals].sort((a,b)=>(order[a.horizon]||9)-(order[b.horizon]||9)).map(g=>`
    <article class="goal-card" onclick="selectGoal('${g.id}')">
      <div class="goal-top">
        <div>
          <div class="domain">${cap(g.horizon)} · ${esc(g.domain)}</div>
          <h4>${esc(g.title)}</h4>
        </div>
        <span class="chip ${g.priority==="high"?"high":""}">${cap(g.priority)}</span>
      </div>

      <p>${esc(g.why || "No rationale added yet.")}</p>

      <div class="progress-head"><span>Progress</span><b>${Number(g.progress||0)}%</b></div>
      <div class="progress"><span style="width:${clamp(Number(g.progress||0),0,100)}%"></span></div>

      <div class="goal-foot">
        <span>${formatDue(g.targetDate)}</span>
        <span>${urgency(g)}</span>
      </div>

      <div class="goal-actions" onclick="event.stopPropagation()">
        <button onclick="adjustProgress('${g.id}',10)">+10%</button>
        <button onclick="adjustProgress('${g.id}',-10)">-10%</button>
        <button onclick="deleteGoal('${g.id}')">Delete</button>
      </div>
    </article>
  `).join("");
}

function renderMilestones(){
  const source = [...goals]
    .filter(g=>Number(g.progress)<100)
    .sort((a,b)=>goalScore(b)-goalScore(a))
    .slice(0,5);

  milestoneList.innerHTML = source.length ? source.map(g=>`
    <div class="list-item">
      <div>
        <strong>${esc(g.title)}</strong>
        <span>${cap(g.horizon)} · ${esc(g.domain)} · ${Number(g.progress||0)}% complete</span>
      </div>
      <b>${formatDue(g.targetDate)}</b>
    </div>
  `).join("") : '<div class="empty">No milestones.</div>';
}

function renderParentOptions(){
  goalParent.innerHTML = '<option value="">None</option>' +
    goals.map(g=>`<option value="${g.id}">${cap(g.horizon)} — ${esc(g.title)}</option>`).join("");
}

function selectGoal(id){
  const g = goals.find(x=>x.id===id);
  if(!g) return;

  const chain = {yearly:null,monthly:null,weekly:null,daily:null};
  chain[g.horizon] = g;

  let cur = g;
  while(cur && cur.parentId){
    cur = goals.find(x=>x.id===cur.parentId);
    if(cur) chain[cur.horizon] = cur;
  }

  if(g.horizon==="yearly"){
    const m = goals.find(x=>x.parentId===g.id && x.horizon==="monthly");
    if(m){chain.monthly=m; const w=goals.find(x=>x.parentId===m.id && x.horizon==="weekly"); if(w){chain.weekly=w; const d=goals.find(x=>x.parentId===w.id && x.horizon==="daily"); if(d) chain.daily=d;}}
  }else if(g.horizon==="monthly"){
    const w=goals.find(x=>x.parentId===g.id && x.horizon==="weekly"); if(w){chain.weekly=w; const d=goals.find(x=>x.parentId===w.id && x.horizon==="daily"); if(d) chain.daily=d;}
  }else if(g.horizon==="weekly"){
    const d=goals.find(x=>x.parentId===g.id && x.horizon==="daily"); if(d) chain.daily=d;
  }

  ladderYear.textContent = chain.yearly?.title || "—";
  ladderMonth.textContent = chain.monthly?.title || "—";
  ladderWeek.textContent = chain.weekly?.title || "—";
  ladderDay.textContent = chain.daily?.title || "—";

  window.scrollTo({top:0,behavior:"smooth"});
}

function openGoalModal(){ goalModal.classList.add("show"); }
function closeGoalModal(){ goalModal.classList.remove("show"); }

goalModal.addEventListener("click",e=>{if(e.target.id==="goalModal") closeGoalModal();});

goalForm.addEventListener("submit",e=>{
  e.preventDefault();

  const goal = {
    id:"g_"+Date.now(),
    title:goalTitle.value.trim(),
    horizon:goalHorizon.value,
    domain:goalDomain.value,
    priority:goalPriority.value,
    progress:clamp(Number(goalProgress.value||0),0,100),
    targetDate:goalDate.value,
    why:goalWhy.value.trim(),
    parentId:goalParent.value
  };

  goals.unshift(goal);
  saveGoals();
  renderAll();
  goalForm.reset();
  goalPriority.value="medium";
  goalProgress.value=0;
  closeGoalModal();
  showToast("Goal added to G·IOS.");
});

function adjustProgress(id,delta){
  const g=goals.find(x=>x.id===id); if(!g) return;
  g.progress=clamp(Number(g.progress||0)+delta,0,100);
  saveGoals(); renderAll();
}

function deleteGoal(id){
  const childIds = goals.filter(g=>g.parentId===id).map(g=>g.id);
  goals = goals.filter(g=>g.id!==id);
  goals.forEach(g=>{if(childIds.includes(g.parentId)) g.parentId="";});
  saveGoals(); renderAll();
}

function returnToHIOS(){
  window.location.href = '/src/app/index.html?view=home';
}

async function signOut(){
  try{await db.auth.signOut();}catch(e){}
  window.location.replace("/src/app/index.html");
}

function goTo(id){ document.getElementById(id)?.scrollIntoView({behavior:"smooth",block:"start"}); }

function formatDue(date){
  if(!date) return "No deadline";
  const today=new Date();today.setHours(0,0,0,0);
  const due=new Date(date+"T00:00:00");
  const days=Math.ceil((due-today)/86400000);
  if(days<0) return Math.abs(days)+"d overdue";
  if(days===0) return "Due today";
  if(days===1) return "Due tomorrow";
  if(days<=30) return "Due in "+days+"d";
  return due.toLocaleDateString(undefined,{day:"numeric",month:"short"});
}

function showToast(message){
  toast.textContent=message; toast.classList.add("show");
  clearTimeout(window.__gt); window.__gt=setTimeout(()=>toast.classList.remove("show"),2200);
}
function clamp(n,min,max){return Math.max(min,Math.min(max,n))}
function cap(v){return v? v.charAt(0).toUpperCase()+v.slice(1):""}
function esc(v){
  return String(v??"")
    .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;")
    .replaceAll('"',"&quot;").replaceAll("'","&#039;");
}

init();
</script>
