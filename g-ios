<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>G·IOS — Goals Intelligence Operating System</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --bg:#07090d;
  --panel:#10131a;
  --panel2:#151922;
  --text:#f5f7fb;
  --muted:#8f98aa;
  --line:#232936;
  --accent:#6ea8ff;
  --accent2:#8b5cf6;
  --good:#36d399;
  --warn:#fbbf24;
  --danger:#fb7185;
  --soft:#0c0f15;
}
*{box-sizing:border-box}
html,body{
  margin:0;
  min-height:100%;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
}
body{
  min-height:100vh;
  color:var(--text);
  background:
    radial-gradient(circle at 13% 8%, rgba(110,168,255,.12), transparent 28%),
    radial-gradient(circle at 88% 2%, rgba(139,92,246,.11), transparent 27%),
    var(--bg);
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}

.app{
  min-height:100vh;
  display:grid;
  grid-template-columns:245px 1fr;
}

.sidebar{
  position:sticky;
  top:0;
  height:100vh;
  border-right:1px solid var(--line);
  background:rgba(7,9,13,.9);
  backdrop-filter:blur(18px);
  padding:22px 18px;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  margin:2px 6px 26px;
}
.logo{
  width:40px;
  height:40px;
  border-radius:13px;
  display:grid;
  place-items:center;
  font-weight:900;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 12px 30px rgba(110,168,255,.18);
}
.brand h1{font-size:18px;margin:0;letter-spacing:.04em}
.brand small{display:block;color:var(--muted);font-size:11px;margin-top:2px}

.nav{display:grid;gap:6px}
.nav button{
  width:100%;
  border:0;
  background:transparent;
  color:var(--muted);
  text-align:left;
  padding:11px 12px;
  border-radius:10px;
}
.nav button:hover,.nav button.active{
  color:var(--text);
  background:var(--panel2);
}

.sidebar-footer{
  position:absolute;
  left:18px;
  right:18px;
  bottom:18px;
  display:grid;
  gap:8px;
}
.family-link,.signout{
  border:1px solid var(--line);
  background:#0d1118;
  color:#c8d1df;
  border-radius:11px;
  padding:10px 12px;
}
.signout{color:#ff9cab;border-color:rgba(251,113,133,.22)}

.main{
  width:100%;
  max-width:1500px;
  margin:0 auto;
  padding:26px 30px 44px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
  margin-bottom:16px;
}
.title h2{
  margin:0;
  font-size:28px;
  letter-spacing:-.02em;
}
.title p{
  margin:6px 0 0;
  color:var(--muted);
  font-size:13px;
}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:11px;
  padding:10px 14px;
}
.btn.primary{
  border:0;
  font-weight:800;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
}
.btn.small{padding:8px 11px;font-size:12px}
.btn:hover{filter:brightness(1.06)}

.overview-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin:6px 0 9px;
}
.overview-head h3{font-size:14px;margin:0}
.overview-head span{font-size:11px;color:var(--muted)}

.metrics{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-bottom:18px;
}
.metric{
  min-height:68px;
  padding:11px 13px;
  border-radius:12px;
  background:var(--soft);
  border:1px solid #1c2230;
}
.metric small{display:block;color:var(--muted);font-size:11px}
.metric b{display:block;font-size:19px;margin-top:4px}
.metric em{font-style:normal;font-size:10px;color:#6f7a8c}

.grid{
  display:grid;
  grid-template-columns:1.22fr .78fr;
  gap:18px;
}
.card{
  background:linear-gradient(180deg,rgba(21,25,34,.97),rgba(16,19,26,.97));
  border:1px solid var(--line);
  border-radius:18px;
  padding:19px;
}
.card h3{font-size:15px;margin:0}
.card .sub{font-size:12px;color:var(--muted);margin-top:5px}

.focus-list{
  display:grid;
  gap:10px;
  margin-top:16px;
}
.focus{
  display:grid;
  grid-template-columns:34px 1fr auto;
  align-items:center;
  gap:12px;
  padding:13px;
  border-radius:13px;
  background:var(--soft);
  border:1px solid #1c2230;
}
.rank{
  width:30px;height:30px;border-radius:9px;
  display:grid;place-items:center;
  font-weight:800;color:var(--accent);
  background:#161c28;
}
.focus b{display:block;font-size:13px}
.focus small{color:var(--muted);font-size:11px}
.chip{
  font-size:10px;
  padding:6px 8px;
  border-radius:999px;
  border:1px solid #283247;
  background:#151c29;
  color:#b8c8e8;
}
.chip.high{color:#ffe0a3;border-color:rgba(251,191,36,.25);background:rgba(251,191,36,.07)}
.chip.risk{color:#ffb0bd;border-color:rgba(251,113,133,.25);background:rgba(251,113,133,.07)}
.chip.good{color:#a7f3d0;border-color:rgba(54,211,153,.25);background:rgba(54,211,153,.07)}

.intel-box{
  margin-top:14px;
  padding:14px;
  border-radius:13px;
  border:1px solid rgba(110,168,255,.18);
  background:rgba(110,168,255,.055);
}
.intel-box strong{display:block;font-size:12px}
.intel-box p{margin:6px 0 0;color:#aeb8c8;font-size:12px;line-height:1.55}

.hierarchy{
  margin-top:16px;
  display:grid;
  gap:8px;
}
.level{
  position:relative;
  padding:11px 12px 11px 36px;
  border:1px solid #1d2430;
  background:#0d1118;
  border-radius:12px;
}
.level:before{
  content:"";
  position:absolute;
  left:15px;top:17px;
  width:8px;height:8px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
}
.level:not(:last-child):after{
  content:"";
  position:absolute;
  left:18px;top:27px;
  width:2px;height:26px;
  background:#273244;
}
.level span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em}
.level b{display:block;font-size:12px;margin-top:3px}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin:25px 0 12px;
}
.section-title h3{font-size:17px;margin:0}
.section-title span{font-size:11px;color:var(--muted)}

.goal-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:13px;
}
.goal-card{
  position:relative;
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:16px;
  padding:16px;
  min-height:180px;
}
.goal-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
}
.goal-domain{
  font-size:10px;
  color:#9cbdf0;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.goal-card h4{margin:7px 0 6px;font-size:14px;line-height:1.35}
.goal-card p{margin:0;color:var(--muted);font-size:11px;line-height:1.5}
.progress-label{
  display:flex;justify-content:space-between;
  margin-top:14px;margin-bottom:6px;
  font-size:11px;
}
.bar{
  height:8px;
  border-radius:999px;
  background:#0a0d12;
  overflow:hidden;
}
.bar span{
  display:block;height:100%;
  border-radius:999px;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
}
.goal-foot{
  display:flex;
  justify-content:space-between;
  margin-top:12px;
  color:var(--muted);
  font-size:10px;
}

.bottom-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin-top:18px;
}
.list{
  display:grid;
  gap:9px;
  margin-top:14px;
}
.list-item{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:11px 12px;
  border:1px solid #1d2430;
  background:#0d1118;
  border-radius:11px;
}
.list-item strong{display:block;font-size:12px}
.list-item span{display:block;color:var(--muted);font-size:10px;margin-top:3px}
.list-item b{font-size:11px;white-space:nowrap}

.empty{
  color:var(--muted);
  font-size:12px;
  padding:18px 2px;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  display:none;
  place-items:center;
  padding:18px;
  background:rgba(0,0,0,.65);
  z-index:30;
}
.modal.show{display:grid}
.modal-box{
  width:min(520px,100%);
  background:#12161e;
  border:1px solid var(--line);
  border-radius:18px;
  padding:21px;
  box-shadow:0 30px 80px rgba(0,0,0,.45);
}
.modal-box h3{margin:0 0 5px;font-size:19px}
.modal-box p{margin:0 0 18px;color:var(--muted);font-size:12px;line-height:1.5}
.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.field{display:grid;gap:6px;margin-bottom:12px}
.field.full{grid-column:1/-1}
label{font-size:11px;color:#c7cfdb}
input,select,textarea{
  width:100%;
  border:1px solid var(--line);
  background:#0a0d12;
  color:var(--text);
  border-radius:10px;
  padding:11px 12px;
  outline:none;
}
textarea{resize:vertical;min-height:80px}
input:focus,select:focus,textarea:focus{
  border-color:#476da9;
  box-shadow:0 0 0 3px rgba(110,168,255,.08);
}
.modal-actions{
  display:flex;
  justify-content:flex-end;
  gap:9px;
  margin-top:6px;
}

.toast{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:50;
  background:#111721;
  border:1px solid #263145;
  color:#dce6f5;
  padding:11px 13px;
  border-radius:11px;
  font-size:12px;
  opacity:0;
  transform:translateY(8px);
  pointer-events:none;
  transition:.2s ease;
}
.toast.show{opacity:1;transform:translateY(0)}

@media(max-width:1050px){
  .goal-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:900px){
  .app{grid-template-columns:1fr}
  .sidebar{
    position:static;
    height:auto;
    border-right:0;
    border-bottom:1px solid var(--line);
  }
  .nav{grid-template-columns:repeat(3,1fr)}
  .sidebar-footer{position:static;margin-top:16px;grid-template-columns:1fr 1fr}
  .main{padding:20px}
  .grid,.bottom-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  .topbar{flex-direction:column}
  .metrics{grid-template-columns:1fr 1fr}
  .goal-grid{grid-template-columns:1fr}
  .nav{grid-template-columns:1fr 1fr}
  .focus{grid-template-columns:32px 1fr}
  .focus .chip{grid-column:2;justify-self:start}
  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:1}
  .main{padding:16px}
}
</style>
</head>
<body>

<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="logo">G</div>
      <div>
        <h1>G·IOS</h1>
        <small>Goals Intelligence Operating System</small>
      </div>
    </div>

    <nav class="nav">
      <button class="active">Overview</button>
      <button onclick="scrollToSection('goalsSection')">Goals</button>
      <button onclick="scrollToSection('focusSection')">Priorities</button>
      <button onclick="scrollToSection('plannerSection')">Planner</button>
      <button onclick="showToast('Reviews will be added in the next G·IOS build.')">Reviews</button>
      <button onclick="showToast('Goal Intelligence view will be expanded next.')">Intelligence</button>
    </nav>

    <div class="sidebar-footer">
      <button class="family-link" onclick="goHome()">← H·IOS Family</button>
      <button class="signout" onclick="logout()">Sign Out</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="title">
        <h2>Goal Intelligence</h2>
        <p>Turn long-term intentions into dynamically prioritized action.</p>
      </div>
      <div class="actions">
        <button class="btn" onclick="showToast('Priority explanation panel will become interactive in the next build.')">Why this order?</button>
        <button class="btn primary" onclick="openGoalModal()">+ Add Goal</button>
      </div>
    </header>

    <div class="overview-head">
      <h3>Intelligence Overview</h3>
      <span>Live goal state across your H·IOS ecosystem</span>
    </div>

    <section class="metrics">
      <div class="metric">
        <small>Active goals</small>
        <b id="metricActive">0</b>
        <em>Across all domains</em>
      </div>
      <div class="metric">
        <small>High-priority items</small>
        <b id="metricHigh">0</b>
        <em>Require attention now</em>
      </div>
      <div class="metric">
        <small>On-track goals</small>
        <b id="metricOnTrack">0</b>
        <em>Progressing as planned</em>
      </div>
      <div class="metric">
        <small>At-risk goals</small>
        <b id="metricRisk">0</b>
        <em>Needs intervention</em>
      </div>
    </section>

    <section class="grid">
      <div class="card" id="focusSection">
        <h3>Today's Focus</h3>
        <div class="sub">G·IOS ranks what deserves attention based on urgency, importance, progress and dependencies.</div>

        <div class="focus-list" id="focusList"></div>

        <div class="intel-box">
          <strong>Priority Intelligence</strong>
          <p id="priorityInsight">
            G·IOS is currently using goal urgency, target dates and progress to rank attention.
            As T·IOS, S·IOS and future products connect, this layer can become increasingly dynamic.
          </p>
        </div>
      </div>

      <div class="card">
        <h3>Goal Hierarchy</h3>
        <div class="sub">Selected goal translated from long-term direction into immediate action.</div>

        <div class="hierarchy">
          <div class="level">
            <span>Long-term direction</span>
            <b id="hierLong">Build a high-performance life system</b>
          </div>
          <div class="level">
            <span>Yearly objective</span>
            <b id="hierYear">Progress across education, trading and personal development</b>
          </div>
          <div class="level">
            <span>Monthly milestone</span>
            <b id="hierMonth">Complete the current highest-value milestone</b>
          </div>
          <div class="level">
            <span>This week</span>
            <b id="hierWeek">Protect time for priority work</b>
          </div>
          <div class="level">
            <span>Today</span>
            <b id="hierToday">Execute the #1 priority without unnecessary switching</b>
          </div>
        </div>
      </div>
    </section>

    <div class="section-title" id="goalsSection">
      <h3>Current Goals</h3>
      <span>Click a goal to make it the active hierarchy context</span>
    </div>

    <section class="goal-grid" id="goalGrid"></section>

    <section class="bottom-grid" id="plannerSection">
      <div class="card">
        <h3>Upcoming Milestones</h3>
        <div class="sub">What is approaching next.</div>
        <div class="list" id="milestoneList"></div>
      </div>

      <div class="card">
        <h3>Cross-Intelligence Signals</h3>
        <div class="sub">Signals G·IOS may eventually receive from connected products.</div>
        <div class="list">
          <div class="list-item">
            <div>
              <strong>T·IOS</strong>
              <span>Trading sample progress and execution quality</span>
            </div>
            <b>Connected</b>
          </div>
          <div class="list-item">
            <div>
              <strong>S·IOS</strong>
              <span>Assessments, workload, study progress and deadlines</span>
            </div>
            <b>Planned</b>
          </div>
          <div class="list-item">
            <div>
              <strong>Future ·IOS</strong>
              <span>Additional domains can influence priorities when relevant</span>
            </div>
            <b>Expandable</b>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="modal" id="goalModal">
  <div class="modal-box">
    <h3>Add a Goal</h3>
    <p>Create an initial G·IOS goal. This version stores your goals in your browser under your signed-in account.</p>

    <form id="goalForm">
      <div class="form-grid">
        <div class="field full">
          <label>Goal title</label>
          <input id="goalTitle" required placeholder="e.g. Complete Phase 1 trading sample">
        </div>

        <div class="field">
          <label>Domain</label>
          <select id="goalDomain">
            <option>Trading</option>
            <option>Education</option>
            <option>Career</option>
            <option>Fitness</option>
            <option>Business</option>
            <option>Personal</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field">
          <label>Priority</label>
          <select id="goalPriority">
            <option value="high">High</option>
            <option value="medium" selected>Medium</option>
            <option value="low">Low</option>
          </select>
        </div>

        <div class="field">
          <label>Target date</label>
          <input id="goalDate" type="date">
        </div>

        <div class="field">
          <label>Progress %</label>
          <input id="goalProgress" type="number" min="0" max="100" value="0">
        </div>

        <div class="field full">
          <label>Why this goal matters</label>
          <textarea id="goalWhy" placeholder="Short reason or intended outcome"></textarea>
        </div>
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" onclick="closeGoalModal()">Cancel</button>
        <button class="btn primary" type="submit">Create Goal</button>
      </div>
    </form>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   AUTH — SAME SUPABASE PROJECT AS H·IOS / T·IOS
========================================================= */
const SUPABASE_URL = "https://tmxosoyqflmwqzjgnkez.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_meHq49fLyw8PVNPZxWacnw_SQMj5B-h";
const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

let currentUser = null;
let goals = [];
let storageKey = 'gios_goals_guest';

const defaultGoals = [
  {
    id:'g1',
    title:'Complete current engineering assessment cycle',
    domain:'Education',
    priority:'high',
    progress:72,
    targetDate:'',
    why:'Protect academic performance and finish current coursework.',
    status:'on-track'
  },
  {
    id:'g2',
    title:'Complete Phase 1 trading execution sample',
    domain:'Trading',
    priority:'high',
    progress:61,
    targetDate:'',
    why:'Build reliable execution before focusing on edge expansion.',
    status:'on-track'
  },
  {
    id:'g3',
    title:'Maintain weekly fitness consistency',
    domain:'Fitness',
    priority:'medium',
    progress:88,
    targetDate:'',
    why:'Maintain energy and physical performance.',
    status:'on-track'
  }
];

async function init(){
  try{
    const { data, error } = await db.auth.getSession();

    if(error || !data?.session?.user){
      window.location.replace('index.html');
      return;
    }

    currentUser = data.session.user;
    storageKey = 'gios_goals_' + currentUser.id;
    loadGoals();
    renderAll();

  }catch(err){
    console.error(err);
    window.location.replace('index.html');
  }
}

function loadGoals(){
  try{
    const saved = localStorage.getItem(storageKey);
    if(saved){
      goals = JSON.parse(saved);
      if(!Array.isArray(goals)) goals = [];
    }
  }catch(e){
    goals = [];
  }

  if(goals.length === 0){
    goals = defaultGoals.map(g => ({...g}));
    saveGoals();
  }
}

function saveGoals(){
  localStorage.setItem(storageKey, JSON.stringify(goals));
}

function renderAll(){
  renderMetrics();
  renderFocus();
  renderGoals();
  renderMilestones();
}

function renderMetrics(){
  const active = goals.length;
  const high = goals.filter(g => g.priority === 'high' && Number(g.progress) < 100).length;
  const onTrack = goals.filter(g => Number(g.progress) >= 50 && Number(g.progress) < 100).length;
  const risk = goals.filter(g => Number(g.progress) < 35 && g.priority === 'high').length;

  document.getElementById('metricActive').textContent = active;
  document.getElementById('metricHigh').textContent = high;
  document.getElementById('metricOnTrack').textContent = onTrack;
  document.getElementById('metricRisk').textContent = risk;
}

function priorityScore(goal){
  let score = 0;

  if(goal.priority === 'high') score += 60;
  if(goal.priority === 'medium') score += 35;
  if(goal.priority === 'low') score += 15;

  const progress = Number(goal.progress || 0);
  if(progress < 25) score += 20;
  else if(progress < 60) score += 10;

  if(goal.targetDate){
    const today = new Date();
    today.setHours(0,0,0,0);

    const due = new Date(goal.targetDate + 'T00:00:00');
    const days = Math.ceil((due - today) / 86400000);

    if(days <= 0) score += 45;
    else if(days <= 2) score += 35;
    else if(days <= 7) score += 22;
    else if(days <= 30) score += 8;
  }

  return score;
}

function rankedGoals(){
  return [...goals]
    .filter(g => Number(g.progress) < 100)
    .sort((a,b) => priorityScore(b) - priorityScore(a));
}

function renderFocus(){
  const container = document.getElementById('focusList');
  const ranked = rankedGoals().slice(0,4);

  if(ranked.length === 0){
    container.innerHTML = '<div class="empty">No active priorities. Add a goal to begin.</div>';
    return;
  }

  container.innerHTML = ranked.map((g,i) => {
    const urgency = getUrgency(g);
    const cls = urgency === 'Very high' ? 'risk' : urgency === 'High' ? 'high' : '';
    return `
      <div class="focus">
        <div class="rank">${i+1}</div>
        <div>
          <b>${escapeHtml(g.title)}</b>
          <small>${escapeHtml(g.domain)} · ${formatDue(g.targetDate)} · ${Number(g.progress)||0}% complete</small>
        </div>
        <span class="chip ${cls}">${urgency}</span>
      </div>
    `;
  }).join('');

  const top = ranked[0];
  if(top){
    document.getElementById('priorityInsight').textContent =
      `${top.title} is currently ranked first because its priority, progress and timing produce the strongest attention signal.`;
  }
}

function getUrgency(goal){
  const score = priorityScore(goal);
  if(score >= 90) return 'Very high';
  if(score >= 65) return 'High';
  if(score >= 40) return 'Moderate';
  return 'Maintain';
}

function renderGoals(){
  const grid = document.getElementById('goalGrid');

  if(goals.length === 0){
    grid.innerHTML = '<div class="empty">No goals yet. Press “Add Goal” to create your first G·IOS goal.</div>';
    return;
  }

  grid.innerHTML = goals.map(g => `
    <article class="goal-card" onclick="selectGoal('${g.id}')">
      <div class="goal-top">
        <div>
          <div class="goal-domain">${escapeHtml(g.domain)}</div>
          <h4>${escapeHtml(g.title)}</h4>
        </div>
        <span class="chip ${g.priority === 'high' ? 'high' : ''}">${capitalize(g.priority)}</span>
      </div>

      <p>${escapeHtml(g.why || 'No goal rationale added yet.')}</p>

      <div class="progress-label">
        <span>Progress</span>
        <b>${Number(g.progress)||0}%</b>
      </div>

      <div class="bar"><span style="width:${clamp(Number(g.progress)||0,0,100)}%"></span></div>

      <div class="goal-foot">
        <span>${formatDue(g.targetDate)}</span>
        <span>${getUrgency(g)}</span>
      </div>
    </article>
  `).join('');
}

function renderMilestones(){
  const list = document.getElementById('milestoneList');

  const dated = goals
    .filter(g => g.targetDate && Number(g.progress) < 100)
    .sort((a,b) => new Date(a.targetDate) - new Date(b.targetDate))
    .slice(0,5);

  const source = dated.length ? dated : rankedGoals().slice(0,4);

  if(source.length === 0){
    list.innerHTML = '<div class="empty">No upcoming milestones.</div>';
    return;
  }

  list.innerHTML = source.map(g => `
    <div class="list-item">
      <div>
        <strong>${escapeHtml(g.title)}</strong>
        <span>${escapeHtml(g.domain)} · ${Number(g.progress)||0}% complete</span>
      </div>
      <b>${formatDue(g.targetDate)}</b>
    </div>
  `).join('');
}

function selectGoal(id){
  const g = goals.find(x => x.id === id);
  if(!g) return;

  document.getElementById('hierLong').textContent = g.why || g.title;
  document.getElementById('hierYear').textContent = g.title;
  document.getElementById('hierMonth').textContent =
    Number(g.progress) < 50 ? 'Build meaningful progress toward this goal' : 'Move this goal toward completion';
  document.getElementById('hierWeek').textContent =
    g.priority === 'high' ? 'Protect dedicated time for this high-priority goal' : 'Maintain consistent weekly progress';
  document.getElementById('hierToday').textContent =
    `Complete the next concrete action for: ${g.title}`;

  showToast('Goal hierarchy updated.');
  window.scrollTo({top:0,behavior:'smooth'});
}

function openGoalModal(){
  document.getElementById('goalModal').classList.add('show');
}

function closeGoalModal(){
  document.getElementById('goalModal').classList.remove('show');
}

document.getElementById('goalModal').addEventListener('click', (e) => {
  if(e.target.id === 'goalModal') closeGoalModal();
});

document.getElementById('goalForm').addEventListener('submit', (e) => {
  e.preventDefault();

  const goal = {
    id:'g_' + Date.now(),
    title:document.getElementById('goalTitle').value.trim(),
    domain:document.getElementById('goalDomain').value,
    priority:document.getElementById('goalPriority').value,
    progress:clamp(Number(document.getElementById('goalProgress').value || 0),0,100),
    targetDate:document.getElementById('goalDate').value,
    why:document.getElementById('goalWhy').value.trim(),
    status:'active'
  };

  goals.unshift(goal);
  saveGoals();
  renderAll();
  document.getElementById('goalForm').reset();
  document.getElementById('goalProgress').value = 0;
  document.getElementById('goalPriority').value = 'medium';
  closeGoalModal();
  showToast('Goal added to G·IOS.');
});

function scrollToSection(id){
  document.getElementById(id)?.scrollIntoView({behavior:'smooth',block:'start'});
}

function goHome(){
  window.location.href = 'index.html?view=home';
}

async function logout(){
  try{ await db.auth.signOut(); }catch(e){}
  window.location.replace('index.html');
}

function formatDue(date){
  if(!date) return 'No deadline';

  const today = new Date();
  today.setHours(0,0,0,0);

  const due = new Date(date + 'T00:00:00');
  const days = Math.ceil((due - today)/86400000);

  if(days < 0) return `${Math.abs(days)}d overdue`;
  if(days === 0) return 'Due today';
  if(days === 1) return 'Due tomorrow';
  if(days <= 30) return `Due in ${days}d`;

  return due.toLocaleDateString(undefined,{day:'numeric',month:'short'});
}

function showToast(message){
  const toast = document.getElementById('toast');
  toast.textContent = message;
  toast.classList.add('show');
  clearTimeout(window.__toastTimer);
  window.__toastTimer = setTimeout(()=>toast.classList.remove('show'),2200);
}

function clamp(n,min,max){ return Math.max(min,Math.min(max,n)); }
function capitalize(v){ return v ? v.charAt(0).toUpperCase()+v.slice(1) : ''; }
function escapeHtml(v){
  return String(v ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'","&#039;");
}

init();
</script>
